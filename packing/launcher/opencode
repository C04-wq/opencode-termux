#!/data/data/com.termux/files/usr/bin/sh
# OpenCode launcher for Android/Termux.
#
# 2.2.7 ships the module graph as JavaScript and runs it on Termux's `bun`
# instead of compiling one ELF per release. This wrapper is the executable the
# package owns; it locates the bundle next to itself and execs the runtime.
#
# Layout (identical for `pkg`/`apt` and the curl installer):
#   <base>/bin/opencode          this script
#   <base>/lib/opencode/         index.js, hashed assets, native libraries
set -eu

# Resolve $0 through symlinks so a link in $PREFIX/bin still finds its bundle.
resolve_link() {
  target=$1
  while [ -L "$target" ]; do
    link=$(readlink "$target") || break
    case $link in
      /*) target=$link ;;
      *) target=$(dirname "$target")/$link ;;
    esac
  done
  printf '%s\n' "$target"
}

self=$(resolve_link "$0")
case $self in
  */*) self_dir=$(cd "$(dirname "$self")" && pwd) ;;
  *) self_dir=$(pwd) ;;
esac
base=$(cd "$self_dir/.." && pwd)
root=${OPENCODE_ROOT:-$base/lib/opencode}

# Unattended device-side updates: check at most once every six hours, only
# before starting a normal OpenCode session. The updater verifies the release
# checksums and uses the installer's transactional replacement/rollback path.
# Set OPENCODE_TERMUX_AUTOUPDATE=0 to opt out.
case "${1:-}" in
  --version|-v|--help|-h|update|upgrade) AUTO_UPDATE_SKIP=1 ;;
  *) AUTO_UPDATE_SKIP=0 ;;
esac
if [ -n "${PREFIX:-}" ] &&
   [ -z "${OPENCODE_ROOT:-}" ] &&
   [ "${OPENCODE_TERMUX_AUTOUPDATE:-1}" != "0" ] &&
   [ "$AUTO_UPDATE_SKIP" = "0" ] &&
   [ -x "$PREFIX/bin/opencode-termux-update" ]; then
  cache_dir="$PREFIX/var/cache/opencode-termux"
  log_dir="$PREFIX/var/log/opencode-termux"
  state="$cache_dir/last-auto-update-check"
  lock="$cache_dir/auto-update.lock"
  mkdir -p "$cache_dir" "$log_dir"
  now="$(date +%s 2>/dev/null || echo 0)"
  last="$(cat "$state" 2>/dev/null || echo 0)"
  case "$now:$last" in
    *[!0-9:]*|:*) now=0; last=0 ;;
  esac
  if [ "$now" -gt 0 ] && { [ "$last" -eq 0 ] || [ "$now" -lt "$last" ] || [ "$((now - last))" -ge 21600 ]; }; then
    (
      if mkdir "$lock" 2>/dev/null; then
        trap 'rmdir "$lock" 2>/dev/null || true' EXIT HUP INT TERM
        printf '%s\n' "$now" > "$state.tmp"
        mv "$state.tmp" "$state"
        if command -v timeout >/dev/null 2>&1; then
          timeout 120 "$PREFIX/bin/opencode-termux-update" >> "$log_dir/auto-update.log" 2>&1 || true
        else
          "$PREFIX/bin/opencode-termux-update" >> "$log_dir/auto-update.log" 2>&1 || true
        fi
      fi
    )
  fi
fi

if [ -z "${OPENCODE_BUN:-}" ]; then
  if [ -n "${PREFIX:-}" ] && [ -x "$PREFIX/bin/bun" ]; then
    OPENCODE_BUN=$PREFIX/bin/bun
  else
    OPENCODE_BUN=$(command -v bun || true)
  fi
fi
if [ -z "$OPENCODE_BUN" ]; then
  echo "opencode: bun is not installed. Install it with: pkg install bun" >&2
  exit 1
fi
if [ ! -f "$root/index.js" ]; then
  echo "opencode: bundle missing at $root/index.js; reinstall opencode" >&2
  exit 1
fi

# Under bun, process.execPath is the interpreter; preserve an explicit public
# launcher from the installer, otherwise use this executable (e.g. a candidate).
OPENCODE_LAUNCHER="${OPENCODE_LAUNCHER:-$self}"
OPENCODE_ROOT=$root
export OPENCODE_LAUNCHER OPENCODE_ROOT
export OPENCODE_DISABLE_AUTOUPDATE=1

# New bundles carry a requirement marker and the official Android daemon.
# Older published bundles predate this component and remain launchable during migration.
if [ -f "$root/opencode-pty.required" ]; then
  if [ ! -x "$root/opencode-pty" ]; then
    echo "opencode: required official PTY daemon is missing or not executable: $root/opencode-pty" >&2
    exit 1
  fi
  OPENCODE_PTY_BIN=$root/opencode-pty
  export OPENCODE_PTY_BIN
elif [ -x "$root/opencode-pty" ]; then
  OPENCODE_PTY_BIN=$root/opencode-pty
  export OPENCODE_PTY_BIN
fi

# bun-pty dlopens this at import time; upstream npm packages ship glibc/musl.
# Select only the native library built for this exact Android architecture.
if [ -z "${BUN_PTY_LIB:-}" ]; then
  case "$(uname -m)" in
    aarch64) BUN_PTY_LIB="$root/librust_pty_arm64.so" ;;
    x86_64) BUN_PTY_LIB="$root/librust_pty_x86_64.so" ;;
    *)
      echo "opencode: unsupported architecture $(uname -m); supported: aarch64, x86_64" >&2
      exit 1
      ;;
  esac
fi
if [ ! -f "$BUN_PTY_LIB" ]; then
  echo "opencode: native PTY library is missing: $BUN_PTY_LIB" >&2
  exit 1
fi
export BUN_PTY_LIB

# @parcel/watcher needs an OpenCode-owned bionic build; upstream resolves the
# package name from process.platform, which is "android" here.
if [ -f "$root/watcher.node" ]; then
  OPENCODE_PARCEL_WATCHER_PATH=$root/watcher.node
  export OPENCODE_PARCEL_WATCHER_PATH
fi

if [ -n "${PREFIX:-}" ]; then
  LD_LIBRARY_PATH=$PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
  export LD_LIBRARY_PATH
fi

version=__OPENCODE_VERSION__
exec "$OPENCODE_BUN" \
  --smol \
  --no-install \
  --no-env-file \
  --no-warnings \
  --use-system-ca \
  --config="$root/bunfig.toml" \
  --user-agent="opencode/latest/$version/cli" \
  "$root/index.js" "$@"
