#!/data/data/com.termux/files/usr/bin/bash
export LD_PRELOAD=

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd "$(dirname "$SOURCE")/.." && pwd)"
LIB_DIR="$DIR/lib"

if [ ! -f "$LIB_DIR/opencode" ]; then
  node "$DIR/install.js"
fi

CURRENT=$(node -e "console.log(require('$DIR/package.json').version)" 2>/dev/null)
LATEST=$(timeout 10 npm view opencode-termux version 2>/dev/null)

if [ -n "$LATEST" ] && [ "$CURRENT" != "$LATEST" ]; then
  echo "Updating opencode-termux v${CURRENT} -> v${LATEST}..."
  npm update -g opencode-termux 2>/dev/null
  SOURCE2="${BASH_SOURCE[0]}"
  while [ -h "$SOURCE2" ]; do
    D2="$(cd "$(dirname "$SOURCE2")" && pwd)"
    SOURCE2="$(readlink "$SOURCE2")"
    [[ $SOURCE2 != /* ]] && SOURCE2="$D2/$SOURCE2"
  done
  DIR="$(cd "$(dirname "$SOURCE2")/.." && pwd)"
  LIB_DIR="$DIR/lib"
fi

export LD_LIBRARY_PATH="$LIB_DIR"
export SSL_CERT_FILE=/data/data/com.termux/files/usr/etc/tls/cert.pem

exec "$LIB_DIR/opencode" "$@"
