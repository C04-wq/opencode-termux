#!/data/data/com.termux/files/usr/bin/bash
export LD_PRELOAD=

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd "$(dirname "$SOURCE")/.." && pwd)"
LIB_DIR="$DIR/lib"

if [ ! -f "$LIB_DIR/opencode" ]; then
  echo "opencode-termux: First run, downloading binary..."
  node "$DIR/install.js"
  if [ ! -f "$LIB_DIR/opencode" ]; then
    echo "Error: Download failed. Run manually: node $DIR/install.js"
    exit 1
  fi
fi

export LD_LIBRARY_PATH="$LIB_DIR"
export SSL_CERT_FILE=/data/data/com.termux/files/usr/etc/tls/cert.pem
export SSL_CERT_DIR=/data/data/com.termux/files/usr/etc/tls/certs
export NODE_EXTRA_CA_CERTS=/data/data/com.termux/files/usr/etc/tls/certs
export OPENCODE_DISABLE_AUTOUPDATE=true

CURRENT_VERSION=$(node -e "console.log(require('$DIR/package.json').version)" 2>/dev/null || echo "unknown")

CHECK_FILE="$DIR/.last_update_check"
NOW=$(date +%s)
CHECK_INTERVAL=86400

should_check() {
  if [ ! -f "$CHECK_FILE" ]; then
    return 0
  fi
  LAST_CHECK=$(cat "$CHECK_FILE" 2>/dev/null || echo "0")
  DIFF=$((NOW - LAST_CHECK))
  if [ "$DIFF" -ge "$CHECK_INTERVAL" ]; then
    return 0
  fi
  return 1
}

check_update() {
  LATEST=$(npm view opencode-termux version 2>/dev/null)
  if [ -z "$LATEST" ]; then
    return
  fi
  echo "$NOW" > "$CHECK_FILE"

  if [ "$CURRENT_VERSION" != "$LATEST" ]; then
    COLS=$(tput cols 2>/dev/null || echo 80)
    MSG=" Update available: opencode-termux@$LATEST (current: $CURRENT_VERSION) "
    MSG_LEN=${#MSG}
    PAD=$(( (COLS - MSG_LEN) / 2 ))
    [ $PAD -lt 0 ] && PAD=0
    SPACES=$(printf '%*s' "$PAD" '')
    printf "\033[38;5;220m%s%s\033[0m\n" "$SPACES" "$MSG"
    printf "\033[38;5;220m%s\033[0m\n" "$SPACES Run: npm update -g opencode-termux"
  fi
}

if should_check; then
  check_update &
fi

exec "$LIB_DIR/opencode" "$@"
