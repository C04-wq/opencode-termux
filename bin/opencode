#!/data/data/com.termux/files/usr/bin/bash
set -o pipefail
export OPENCODE_DISABLE_AUTOUPDATE=1

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd "$(dirname "$SOURCE")/.." && pwd)"
OPENCODE_DIR="$HOME/.opencode"
case "$(node -p 'process.arch')" in
  arm64) RUNTIME_LOADER="ld-musl-aarch64.so.1"; RUNTIME_LIBC="libc.musl-aarch64.so.1" ;;
  x64) RUNTIME_LOADER="ld-musl-x86_64.so.1"; RUNTIME_LIBC="libc.musl-x86_64.so.1" ;;
  *) echo "Error: opencode-termux supports Android arm64 and x86_64 only." >&2; exit 1 ;;
esac
CURRENT="$(node -e 'console.log(require(process.argv[1]).version)' "$DIR/package.json" 2>/dev/null)"
INSTALLED_VERSION="$(cat "$OPENCODE_DIR/.opencode-termux-version" 2>/dev/null || true)"

install_opencode() {
  node "$DIR/install.js"
}

# Check all required Termux dependencies on every launch.
# install.js stays silent when everything is already available.
node "$DIR/install.js" --ensure-dependencies || exit $?

if [ ! -f "$OPENCODE_DIR/opencode" ] || [ ! -f "$OPENCODE_DIR/$RUNTIME_LOADER" ] || [ ! -f "$OPENCODE_DIR/$RUNTIME_LIBC" ] || [ ! -f "$OPENCODE_DIR/libgcc_s.so.1" ] || [ ! -f "$OPENCODE_DIR/libstdc++.so.6" ] || [ ! -f "$OPENCODE_DIR/libstdc++.so.6.runtime" ] || [ "$CURRENT" != "$INSTALLED_VERSION" ]; then
  install_opencode || exit $?
fi

# Record only after the installed package has a verified, active runtime.
node "$DIR/bin/opencode-termux" record >/dev/null 2>&1 || true

# Check at most once per 24 hours. Updates are never installed without consent.
# OPENCODE_TERMUX_AUTOUPDATE=0 disables the version check entirely.
if [ "${OPENCODE_TERMUX_AUTOUPDATE:-1}" != "0" ]; then
  CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/opencode-termux"
  CHECK_FILE="$CACHE_DIR/last-update-check"
  NOW="$(date +%s)"
  LAST_CHECK="$(cat "$CHECK_FILE" 2>/dev/null || echo 0)"
  if ! [[ "$LAST_CHECK" =~ ^[0-9]+$ ]] || [ $((NOW - LAST_CHECK)) -ge 86400 ] || [ "$NOW" -lt "$LAST_CHECK" ]; then
    mkdir -p "$CACHE_DIR" 2>/dev/null || true
    LATEST="$(timeout 10 npm view opencode-termux version 2>/dev/null || true)"
    if [[ "$LATEST" =~ ^[0-9]+\.[0-9]+\.[0-9]+([-.][0-9A-Za-z.-]+)?$ ]]; then
      printf '%s\n' "$NOW" > "$CHECK_FILE" 2>/dev/null || true
    else
      LATEST=""
    fi
  else
    LATEST=""
  fi
else
  LATEST=""
fi

if [[ "$LATEST" =~ ^[0-9]+\.[0-9]+\.[0-9]+([-.][0-9A-Za-z.-]+)?$ ]] && [ "$CURRENT" != "$LATEST" ]; then
  UPDATE_ANSWER="no"
  if [ -t 0 ] && [ -t 1 ]; then
    # Dedicated alternate screen keeps the prompt separate from shell output.
    printf '\033[?1049h\033[?25l\033[2J\033[H'
    UPDATE_CHOICE=1
    while :; do
      printf '\033[H\033[J'
      printf '\033[1;36m  OpenCode Termux\033[0m\n\n'
      printf '  Update available\n  Installed  %s\n  Available  %s\n\n' "$CURRENT" "$LATEST"
      printf '  Install this update?\n\n'
      if [ "$UPDATE_CHOICE" -eq 0 ]; then
        printf '  \033[32m❯ Yes\033[0m\n    No\n'
      else
        printf '    Yes\n  \033[32m❯ No\033[0m\n'
      fi
      printf '\n  Use ↑/↓ and Enter to confirm. Press q to skip.\n'
      IFS= read -rsn1 KEY || KEY=""
      case "$KEY" in
        $'\x1b')
          IFS= read -rsn1 -t 1 K1 || K1=""
          IFS= read -rsn1 -t 1 K2 || K2=""
          if [ "$K1" = "[" ]; then case "$K2" in A|B) UPDATE_CHOICE=$((1 - UPDATE_CHOICE));; esac; fi
          ;;
        "") break ;;
        " ") UPDATE_CHOICE=$((1 - UPDATE_CHOICE));;
        y|Y) UPDATE_CHOICE=0; break ;;
        n|N|q|Q) UPDATE_CHOICE=1; break ;;
      esac
    done
    printf '\033[?1049l\033[?25h'
    [ "$UPDATE_CHOICE" -eq 0 ] && UPDATE_ANSWER="yes" || UPDATE_ANSWER="no"
  else
    printf 'Update available: %s (installed: %s). Non-interactive session; keeping the installed version.\n' "$LATEST" "$CURRENT"
  fi
  if [ "$UPDATE_ANSWER" = "yes" ]; then
    if [ -t 1 ]; then
      printf '\033[?1049h\033[?25l\033[2J\033[H'
      printf '\033[1;36m  OpenCode Termux\033[0m\n\n'
      printf '  Updating %s -> %s\n\n  Please wait while the package is installed...\n' "$CURRENT" "$LATEST"
    else
      printf 'Updating opencode-termux %s to %s...\n' "$CURRENT" "$LATEST"
    fi
    if npm install -g "opencode-termux@${LATEST}" --ignore-scripts --silent; then
      [ -t 1 ] && printf '\033[?1049l\033[?25h'
      exec "$(command -v opencode)" "$@"
    fi
    [ -t 1 ] && printf '\033[?1049l\033[?25h'
    printf 'Warning: update failed; keeping the installed version %s.\n' "$CURRENT" >&2
  else
    printf 'Keeping the installed version %s.\n' "$CURRENT"
  fi
fi

unset LD_PRELOAD
export LD_LIBRARY_PATH="$OPENCODE_DIR"
export SSL_CERT_FILE=/data/data/com.termux/files/usr/etc/tls/cert.pem

exec "$OPENCODE_DIR/$RUNTIME_LOADER" \
  --library-path "$OPENCODE_DIR" \
  "$OPENCODE_DIR/opencode" "$@"
