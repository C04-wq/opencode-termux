#!/data/data/com.termux/files/usr/bin/bash
export OPENCODE_DISABLE_AUTOUPDATE=1

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd "$(dirname "$SOURCE")/.." && pwd)"
OPENCODE_DIR="$HOME/.opencode"

if [ ! -f "$OPENCODE_DIR/opencode" ]; then
  node "$DIR/install.js"
fi

CURRENT=$(node -e "console.log(require('$DIR/package.json').version)" 2>/dev/null)
LATEST=$(timeout 10 npm view opencode-termux version 2>/dev/null)

if [ -n "$LATEST" ] && [ "$CURRENT" != "$LATEST" ]; then
  echo "Updating to v${LATEST}..."
  npm install -g opencode-termux@latest --force --silent 2>/dev/null
  rm -f "$OPENCODE_DIR/opencode"
  node "$DIR/install.js"
fi

if [ ! -f "$OPENCODE_DIR/opencode" ]; then
  echo "Error: could not install opencode." >&2
  exit 1
fi

export LD_PRELOAD="$OPENCODE_DIR/ld-musl-aarch64.so.1"
export LD_LIBRARY_PATH="$OPENCODE_DIR"
export SSL_CERT_FILE=/data/data/com.termux/files/usr/etc/tls/cert.pem

exec "$OPENCODE_DIR/opencode" "$@"
