#!/data/data/com.termux/files/usr/bin/node
"use strict";
const fs = require("fs");
const path = require("path");
const os = require("os");
const { spawnSync } = require("child_process");

const HOME = process.env.HOME || os.homedir();
const ROOT = path.join(process.env.XDG_CONFIG_HOME || path.join(HOME, ".config"), "opencode-termux");
const CONFIG = path.join(ROOT, "config.json");
const STATE = path.join(process.env.XDG_STATE_HOME || path.join(HOME, ".local", "state"), "opencode-termux");
const HISTORY = path.join(STATE, "versions.json");
const API = "https://api.github.com/repos/C04-wq/opencode-termux/releases?per_page=100&page=";
const CHANNELS = ["stable", "beta", "alpha"];
const ARCHIVE = process.arch === "arm64" ? "opencode-termux-aarch64.tar.gz" : process.arch === "x64" ? "opencode-termux-x86_64.tar.gz" : null;

function ensureDir(file) { fs.mkdirSync(path.dirname(file), { recursive: true, mode: 0o700 }); }
function readJson(file, fallback) {
  try { return JSON.parse(fs.readFileSync(file, "utf8")); } catch (e) {
    if (e.code === "ENOENT") return fallback;
    throw new Error("Cannot read " + file + ": " + e.message);
  }
}
function writeJson(file, value) {
  ensureDir(file);
  const temp = file + ".tmp-" + process.pid;
  fs.writeFileSync(temp, JSON.stringify(value, null, 2) + "\n", { mode: 0o600 });
  fs.renameSync(temp, file);
}
function validVersion(v) { return typeof v === "string" && /^\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?(?:\+[0-9A-Za-z.-]+)?$/.test(v); }
function displayVersion(v) { return String(v).replace(/-\d+$/, ""); }
function tuple(v) { return v.split(/[+-]/, 1)[0].split(".").map(Number); }
function isBankVersion(v) { if (!validVersion(v)) return false; const t = tuple(v); return t[0] > 1 || (t[0] === 1 && (t[1] > 20 || (t[1] === 20 && t[2] >= 0))); }
function currentVersion() {
  try { return require(path.resolve(__dirname, "..", "package.json")).version; } catch (_) { return "unknown"; }
}
function history() { return readJson(HISTORY, { startAt: "1.20.0", entries: [] }); }
function addHistory(version, note) {
  if (!isBankVersion(version)) return;
  const data = history();
  if (!data.entries.some((x) => x.version === version)) {
    data.entries.push({ version, installedAt: new Date().toISOString(), note: note || "installed" });
    data.entries.sort((a, b) => compare(a.version, b.version));
    writeJson(HISTORY, data);
  }
}
function compare(a, b) {
  const aa = a.split(/[+-]/, 1)[0].split(".").map(Number);
  const bb = b.split(/[+-]/, 1)[0].split(".").map(Number);
  for (let i = 0; i < 3; i++) if (aa[i] !== bb[i]) return aa[i] - bb[i];
  return a.localeCompare(b);
}
function config() { const c = readJson(CONFIG, { channel: "stable" }); return CHANNELS.includes(c.channel) ? c : { ...c, channel: "stable" }; }
function saveConfig(c) { writeJson(CONFIG, c); }
function runNpm(args) {
  const result = spawnSync("npm", args, { stdio: "inherit", env: process.env });
  if (result.error) throw result.error;
  if (result.status !== 0) throw new Error("npm command failed with exit code " + result.status);
}
function fetchReleases() {
  const all = [];
  for (let page = 1; page <= 10; page++) {
    const result = spawnSync("curl", ["-fsSL", "--connect-timeout", "8", "--max-time", "20", "-H", "Accept: application/vnd.github+json", "-H", "X-GitHub-Api-Version: 2022-11-28", API + page], { encoding: "utf8" });
    if (result.error || result.status !== 0) throw new Error("Unable to query GitHub Releases. No versions will be offered; check your connection and try again.");
    let batch;
    try { batch = JSON.parse(result.stdout); } catch (_) { throw new Error("GitHub returned invalid release data. No versions will be offered."); }
    if (!Array.isArray(batch)) throw new Error("GitHub returned an unexpected release catalogue. No versions will be offered.");
    all.push(...batch);
    if (batch.length < 100) return all;
  }
  throw new Error("Release catalogue exceeds the safe pagination limit. Refusing to show an incomplete version bank.");
}
function releaseChannel(release) {
  const tag = String(release.tag_name || "").toLowerCase();
  const text = String(release.name || "").toLowerCase();
  if (/\b(alpha|a)[.-]?\d*\b/.test(tag) || /\balpha\b/.test(text)) return "alpha";
  if (/\b(beta|b)[.-]?\d*\b/.test(tag) || /\bbeta\b/.test(text)) return "beta";
  if (release.prerelease) return "beta";
  return "stable";
}
function releaseVersion(release) {
  const tag = String(release.tag_name || "");
  const version = tag.startsWith("v") ? tag.slice(1) : tag;
  return validVersion(version) && isBankVersion(version) ? version : null;
}
function verifiedAsset(release) {
  if (!ARCHIVE) return false;
  const asset = (release.assets || []).find((x) => x.name === ARCHIVE);
  if (!asset || typeof asset.digest !== "string" || !/^sha256:[a-f0-9]{64}$/i.test(asset.digest) || !asset.browser_download_url || !asset.browser_download_url.startsWith("https://github.com/C04-wq/opencode-termux/releases/download/")) return false;
  return true;
}
function publishedVersion(version) {
  const result = spawnSync("npm", ["view", "opencode-termux@" + version, "version", "--json"], { encoding: "utf8", timeout: 15000 });
  if (result.error || result.status !== 0) return false;
  try {
    const v = JSON.parse(result.stdout.trim());
    return v === version || (Array.isArray(v) && v.includes(version));
  } catch (_) { return result.stdout.trim().replace(/^"|"$/g, "") === version; }
}
function catalog(channel) {
  const releases = fetchReleases();
  const seen = new Set();
  return releases.filter((r) => {
    if (r.draft || releaseChannel(r) !== channel) return false;
    const version = releaseVersion(r);
    if (!version || seen.has(version) || !verifiedAsset(r)) return false;
    if (!publishedVersion(version)) return false;
    seen.add(version);
    r.packageVersion = version;
    return true;
  }).sort((a, b) => compare(a.packageVersion, b.packageVersion));
}
function select(items, heading, label) {
  if (!items.length) return null;
  if (!process.stdin.isTTY || !process.stdout.isTTY) {
    throw new Error("Interactive selection is required. Run this command in a Termux terminal.");
  }
  let selected = 0;
  const stdin = process.stdin;
  return new Promise((resolve, reject) => {
    const cleanup = () => {
      if (stdin.isRaw) stdin.setRawMode(false);
      stdin.pause();
      stdin.removeListener("data", onData);
      process.stdout.write("\x1b[?25h\n");
    };
    const paint = () => {
      process.stdout.write("\x1b[?25l\x1b[2J\x1b[H" + heading + "\n\n");
      items.forEach((item, i) => process.stdout.write((i === selected ? "\x1b[32m●\x1b[0m" : " ") + " " + label(item) + "\n"));
      process.stdout.write("\nUse ↑/↓ and Enter. Press q to go back.\n");
    };
    const onData = (buf) => {
      const key = buf.toString();
      if (key === "\u0003" || key.toLowerCase() === "q" || key === "\u001b") { cleanup(); resolve(null); return; }
      if (key === "\u001b[A" || key === "k") selected = (selected - 1 + items.length) % items.length;
      else if (key === "\u001b[B" || key === "j") selected = (selected + 1) % items.length;
      else if (key === "\r" || key === "\n") { const item = items[selected]; cleanup(); resolve(item); return; }
      else return;
      paint();
    };
    stdin.setRawMode(true); stdin.resume(); stdin.on("data", onData); paint();
  });
}
async function chooseChannel() {
  const c = config();
  const chosen = await select(CHANNELS, "Choose a release channel (current: " + c.channel + ")", (x) => x[0].toUpperCase() + x.slice(1) + (x === c.channel ? " (current)" : ""));
  if (!chosen) return null;
  return chosen;
}
async function versions() {
  const chosenChannel = await chooseChannel();
  if (!chosenChannel) { console.log("Cancelled. No changes made."); return; }
  console.log("Loading verified " + chosenChannel + " releases from GitHub...");
  const rows = catalog(chosenChannel);
  if (!rows.length) {
    console.log("No installable " + chosenChannel + " versions found. Releases must include the matching-architecture Termux archive, a valid SHA-256 digest, and the exact published npm package. No local-history versions are substituted.");
    return;
  }
  const current = currentVersion();
  const selected = await select(rows, "Verified " + chosenChannel + " versions (OpenCode 1.20.0+)", (r) => displayVersion(r.packageVersion) + (r.packageVersion === current ? " (installed)" : "") + (r.published_at ? " — " + r.published_at.slice(0, 10) : ""));
  if (!selected) { console.log("Cancelled. No installation started."); return; }
  if (selected.packageVersion === current) { console.log("That version is already installed."); return; }
  const c = config();
  const installedChannel = c.installedChannel || "unknown";
  if (chosenChannel !== installedChannel) {
    const consequences = [
      "WARNING: You are switching release channels.",
      "Previously verified installed channel: " + installedChannel,
      "Selected channel: " + chosenChannel,
      "Possible consequences: the selected build may be less stable, may contain regressions, and may change behavior or compatibility. Returning to the previous channel may require reinstalling its exact version.",
      "Your OpenCode settings and credentials are not intentionally deleted."
    ];
    const decision = await select([{ value: "continue" }, { value: "back" }], consequences.join("\n") + "\n\nContinue with " + selected.packageVersion + "?", (x) => x.value === "continue" ? "Continue" : "Go back");
    if (!decision || decision.value !== "continue") { console.log("Returned without installing anything."); return; }
  }
  const confirm = await select([{ value: "continue" }, { value: "back" }], "Install exact published package opencode-termux@" + selected.packageVersion + "?", (x) => x.value === "continue" ? "Continue" : "Go back");
  if (!confirm || confirm.value !== "continue") { console.log("Returned without installing anything."); return; }
  runNpm(["install", "-g", "opencode-termux@" + selected.packageVersion, "--ignore-scripts", "--silent"]);
  saveConfig({ ...config(), channel: chosenChannel, installedChannel: chosenChannel });
  addHistory(selected.packageVersion, "selected from verified GitHub Releases channel " + chosenChannel);
  console.log("Package installed. Run opencode to prepare and verify the matching runtime archive.");
}
function channel() {
  const c = config();
  const answer = process.argv[3];
  if (!answer) { console.log("Current channel: " + c.channel + "\nUsage: opencode-termux channel stable|beta|alpha"); return; }
  const value = answer.toLowerCase();
  if (!CHANNELS.includes(value)) throw new Error("Invalid channel. Choose stable, beta, or alpha.");
  saveConfig({ ...c, channel: value });
  console.log("Preferred release channel set to " + value + ". Installable versions are determined from verified GitHub Releases.");
}
async function main() {
  const cmd = process.argv[2] || "help";
  if (cmd === "help" || cmd === "--help" || cmd === "-h") {
    console.log("opencode-termux — version manager\n\n  channel [stable|beta|alpha]  Show/set preferred release channel\n  versions                    Browse verified GitHub Releases by channel\n  record                      Record the active package version (local metadata only)\n  rollback [version]          Browse verified releases or install an exact version\n  config                      Show configuration\n  help                        Show this help");
    return;
  }
  if (cmd === "channel") return channel();
  if (cmd === "config") { console.log(JSON.stringify(config(), null, 2)); return; }
  if (cmd === "record") {
    const v = currentVersion();
    if (!isBankVersion(v)) { console.log("Version bank starts at OpenCode 1.20.0; earlier versions are excluded."); return; }
    addHistory(v, "active package observed after runtime verification");
    return;
  }
  if (cmd === "versions") return versions();
  if (cmd === "rollback") {
    const target = process.argv[3];
    if (!target) return versions();
    if (!isBankVersion(target)) throw new Error("Invalid version or version is older than OpenCode 1.20.0.");
    const releases = fetchReleases();
    const release = releases.find((r) => releaseVersion(r) === target && !r.draft && verifiedAsset(r));
    if (!release || !publishedVersion(target)) throw new Error("Version is not an installable, verified GitHub Release with a matching npm package.");
    const currentChannel = config().installedChannel || config().channel;
    const targetChannel = releaseChannel(release);
    if (currentChannel !== targetChannel) {
      const decision = await select([{ value: "continue" }, { value: "back" }], [
        "WARNING: Cross-channel rollback/update",
        "Current channel: " + currentChannel,
        "Target channel: " + targetChannel,
        "Possible consequences: regressions, reduced stability, or behavior changes. Returning to the previous channel may require reinstalling its exact version.",
        "OpenCode settings and credentials are not intentionally deleted."
      ].join("\n"), (x) => x.value === "continue" ? "Continue" : "Go back");
      if (!decision || decision.value !== "continue") { console.log("Returned without installing anything."); return; }
    }
    runNpm(["install", "-g", "opencode-termux@" + target, "--ignore-scripts", "--silent"]);
    saveConfig({ ...config(), installedChannel: targetChannel, channel: targetChannel });
    addHistory(target, "installed exact verified GitHub Release");
    console.log("Package changed. Run opencode to download and verify the matching runtime.");
    return;
  }
  throw new Error("Unknown command: " + cmd + ". Run opencode-termux help");
}
main().catch((e) => { console.error("Error: " + e.message); process.exitCode = 1; });
